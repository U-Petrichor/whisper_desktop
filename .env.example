# Local single-machine development:
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# LAN or remote server deployment:
# Both clients must point to the same reachable backend host.
# Example:
# VITE_API_BASE_URL=http://192.168.1.10:8000
# VITE_WS_BASE_URL=ws://192.168.1.10:8000

# Local Signal prototype bridge. Each desktop client runs its own bridge.
VITE_SIGNAL_RUNTIME_URL=http://127.0.0.1:8765
